# Copy to .env in this folder and fill in. .env is git-ignored: never commit keys.
# Every lab also runs WITHOUT a model (hand-written stand-in scripts). See docs/setup.md, step 5.
# If you still have the .env of the Offer Scout course, its LLM_* lines work here unchanged.

# --- The chat model: any OpenAI-compatible endpoint (POST {LLM_BASE_URL}/chat/completions) ---
# OpenRouter:        https://openrouter.ai/api/v1
# LiteLLM proxy:     http://your-proxy:4000/v1
# OpenAI:            https://api.openai.com/v1
# Ollama (local):    http://localhost:11434/v1      (no key needed)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# The model id exactly as your endpoint lists it. Pick one that is good at tool calling.
LLM_MODEL=

# Optional cheaper model for small jobs (summaries, the model judge in Module 5). Falls back to LLM_MODEL.
LLM_FAST_MODEL=

# Optional. Leave empty unless you know your model accepts them.
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=4000
# LLM_EXTRA_BODY={"parallel_tool_calls": true}

# Set to "standin" to force the offline stand-in even when a key is present (handy for comparing).
# LLM_PROVIDER=standin

# Or use the Claude Code CLI as the model: no API key, no endpoint. Needs `claude` on PATH and logged in.
# Each call runs `claude -p` with its own tools off; the course harness still runs the tools and the checks.
# LLM_PROVIDER=claude-code
# CLAUDE_CODE_MODEL=            # optional CLI model alias such as "sonnet"; empty = the CLI default

# --- Optional: size of the harness hard stops (defaults: 25 model calls, 300 s). A real model explores more
# --- than the stand-in scripts, so raise these for live runs.
# AGENT_MAX_STEPS=60
# AGENT_MAX_SECONDS=600
# AGENT_MAX_FINAL_REJECTIONS=5
# AGENT_MAX_TOTAL_TOKENS=800000

# --- Optional: a real embedding model for the retrieval labs (Module 3) ---
# Uses POST {EMBED_BASE_URL or LLM_BASE_URL}/embeddings. Without it an offline stand-in is used.
# EMBED_MODEL=
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- Optional: prices of your model in USD per million tokens, for the cost numbers in Module 5 ---
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=

# --- Optional: a real GitHub repository instead of the offline fixtures (docs/live-github.md) ---
# GITHUB_TOKEN=
