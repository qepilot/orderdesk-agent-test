diff --git a/orderdesk/pricing.py b/orderdesk/pricing.py
--- a/orderdesk/pricing.py
+++ b/orderdesk/pricing.py
@@ -3,6 +3,9 @@
 from __future__ import annotations
 
+BULK_THRESHOLD = 10
+BULK_PERCENT = 5
+
 
 def line_total(quantity: int, unit_price_cents: int) -> int:
     return quantity * unit_price_cents
@@ -13,3 +16,10 @@ def apply_discount(subtotal_cents: int, percent_off: int) -> int:
     if percent_off <= 0:
         return subtotal_cents
     return int(subtotal_cents * (100 - percent_off) / 100)
+
+
+def bulk_discount_percent(total_units: int) -> int:
+    """Extra percent off for large orders."""
+    if total_units > BULK_THRESHOLD:
+        return BULK_PERCENT
+    return 0
diff --git a/orderdesk/repo.py b/orderdesk/repo.py
--- a/orderdesk/repo.py
+++ b/orderdesk/repo.py
@@ -24,6 +24,13 @@ def active_items(conn: sqlite3.Connection, order_id: int) -> list[sqlite3.Row]:
     ).fetchall()
 
 
+def total_units(conn: sqlite3.Connection, order_id: int) -> int:
+    row = conn.execute(
+        "SELECT COALESCE(SUM(quantity), 0) AS units FROM order_items WHERE order_id = ?", (order_id,)
+    ).fetchone()
+    return row["units"]
+
+
 def discount_percent(conn: sqlite3.Connection, order_id: int) -> int:
