+
+
+def search_orders(conn: sqlite3.Connection, q: str, limit: int) -> list[sqlite3.Row]:
+    sql = (
+        "SELECT o.id, o.status, o.created_at, c.name, c.email "
+        "FROM orders o JOIN customers c ON c.id = o.customer_id "
+        f"WHERE c.name LIKE '%{q}%' OR c.email LIKE '%{q}%' "
+        f"ORDER BY o.created_at DESC LIMIT {limit}"
+    )
+    return conn.execute(sql).fetchall()
