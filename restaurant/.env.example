# Copy to .env and adjust. Never commit real secrets.

# Environment: development | test | production (default: development)
RESTAURANT_ENV=development

# Path of the SQLite database file (default: restaurant/data/restaurant.db)
RESTAURANT_DB_PATH=restaurant/data/restaurant.db

# Secret used for signing. REQUIRED to be a non-default, non-empty value when
# RESTAURANT_ENV=production; the app refuses to start otherwise.
RESTAURANT_SECRET_KEY=change-me

# Sales tax in whole percent, 0-100 (default: 8)
RESTAURANT_TAX_PERCENT=8

# Delivery fee in integer cents, >= 0 (default: 300)
RESTAURANT_DELIVERY_FEE_CENTS=300
